# Database (MySQL via PyMySQL)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/academic_intelligence

# Authentication
JWT_SECRET=Enter your secret key here

# Google Gemini API (google-genai SDK, model: gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS & Frontend URL (comma-separated origins supported)
FRONTEND_URL=http://localhost:5173

# Frontend API URL (Vite)
VITE_API_URL=http://localhost:8000/api/v1
